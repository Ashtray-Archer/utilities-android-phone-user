<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.isomorphisms.pasteboard">
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.android.shell" />
    </queries>
    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:hasCode="true"
        android:label="Pasteboard"
        android:supportsRtl="true"
        android:theme="@style/Theme.Charcoal">
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <provider
            android:name="com.isomorphisms.pasteboard.ShizukuProvider"
            android:authorities="com.isomorphisms.pasteboard.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:exported="true"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.app.lib_name"
                android:value="pasteboard" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
