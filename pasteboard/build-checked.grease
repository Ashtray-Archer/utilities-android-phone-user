#!/usr/bin/env grease
# Checked application source and typed platform declarations use the canonical
# Idriç frontend and android-NDK DEX encoder. Smali is a decoding oracle only.
set -eu -o pipefail
if (len(ARGV) !== 4) {
  echo 'usage: grease build-checked.grease REPOSITORY FRONTEND ANDROID_NDK_REPOSITORY NEW_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var backend = ARGV[2]
var output = ARGV[3]
for path in "$repository" "$frontend" "$backend" "$output" {
  if (path[0] !== '/') { echo 'absolute path required' >&2; exit 2 }
}
if test -e "$output" { echo 'refusing reused checked-source output' >&2; exit 1 }
mkdir -p "$output/source" "$output/assets"
var compiler = "$frontend/_/build/exec/idris2"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
var grease = ENV.GREASE
"$grease" "$backend/dex/idric/install-frontend.grease" "$frontend" > "$output/frontend-api.txt" 2>&1
cd "$backend/dex/idric"
"$compiler" --build backend.ipkg > "$output/backend-compile.txt" 2>&1
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" build/exec/idric-dex_app/
make build/oracles/baksmali-3.0.10.jar build/oracles/smali-3.0.10.jar > "$output/oracles.txt" 2>&1
var oracle = "$backend/dex/idric/build/oracles/baksmali-3.0.10.jar"
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$oracle" | sha256sum -c -
cd "$repository"
cp pasteboard/idric/PasteboardBehavior.idric "$output/source/"
cp examples/autogenerated/pasteboard-behavior/PasteboardBehaviorChecks.idric "$output/source/"
"$compiler" --cg chez --source-dir "$output/source" --build-dir "$output/host-build" \
  --output-dir "$output/host-exec" "$output/source/PasteboardBehaviorChecks.idric" -o checks > "$output/host-compile.txt" 2>&1
"$output/host-exec/checks" > "$output/host-results.txt" 2>&1
rg -x -F 'pasteboard_behavior: all checks passed' "$output/host-results.txt"
for program in GenerateConfig PasteboardContract {
  "$compiler" --cg chez --source-dir "$repository/pasteboard/idric" \
    --build-dir "$output/$program-build" --output-dir "$output/config-exec" \
    "$repository/pasteboard/idric/$program.idric" -o "$program" > "$output/$program-compile.txt" 2>&1
}
"$output/config-exec/GenerateConfig" > "$output/pasteboard_config.generated.h"
cmp pasteboard/app/src/main/c/pasteboard_config.generated.h "$output/pasteboard_config.generated.h"
"$output/config-exec/PasteboardContract" > "$output/config-results.txt"
rg -x -F 'pasteboard_contract: all checks passed' "$output/config-results.txt"
var driver = "$backend/dex/idric/build/exec/idric-dex"
for name in behavior behavior-repeat {
  "$driver" --cg dex --directive managed-exports --source-dir "$output/source" \
    --build-dir "$output/$name-build" --output-dir "$output" \
    "$output/source/PasteboardBehavior.idric" -o "$name" > "$output/$name-compile.txt" 2>&1
  test -s "$output/$name.dex"
  test -s "$output/$name.checked.anf"
}
cmp "$output/behavior.dex" "$output/behavior-repeat.dex"
java -jar "$oracle" disassemble "$output/behavior.dex" -o "$output/behavior-decoded"
rg -x -F '.method public static pasteboard_transition(Ljava/lang/String;)Ljava/lang/String;' "$output/behavior-decoded/Idric/Generated.smali"
setglobal ENV.IDRIS2_PATH = "$backend/dex/idric/build/ttc"
var platform_source = "$repository/examples/autogenerated/pasteboard-behavior"
"$compiler" -p idris2 --cg chez --source-dir "$platform_source" --build-dir "$output/platform-build" \
  --output-dir "$output/platform-exec" "$platform_source/PasteboardPlatform.idric" -o platform > "$output/platform-compile.txt" 2>&1
"$output/platform-exec/platform" "$output/platform.dex" > "$output/platform-results.txt"
"$output/platform-exec/platform" "$output/platform-repeat.dex" >> "$output/platform-results.txt"
cmp "$output/platform.dex" "$output/platform-repeat.dex"
java -jar "$oracle" disassemble "$output/platform.dex" -o "$output/platform-decoded"
for name in ClipboardListener ClipboardObserver ShizukuProvider ShizukuApplicationCallback ShizukuWorkerConnection BinderContainerCreator {
  test -s "$output/platform-decoded/com/isomorphisms/pasteboard/$name.smali"
}
test -s "$output/platform-decoded/moe/shizuku/api/BinderContainer.smali"
# Compile a source-level wrong-order control; never patch candidate DEX bytes.
mkdir -p "$output/mutant-source"
sed 's/{ board := destination } entry :: room/room ++ [{ board := destination } entry]/g' \
  "$output/source/PasteboardBehavior.idric" > "$output/mutant-source/PasteboardBehavior.idric"
cp "$output/source/PasteboardBehaviorChecks.idric" "$output/mutant-source/"
"$compiler" --cg chez --source-dir "$output/mutant-source" --build-dir "$output/mutant-host-build" \
  --output-dir "$output/mutant-host-exec" "$output/mutant-source/PasteboardBehaviorChecks.idric" -o checks > "$output/mutant-host-compile.txt" 2>&1
try { "$output/mutant-host-exec/checks" > "$output/mutant-host-results.txt" 2>&1 }
if (_error.code === 0) { echo 'FAIL source mutant escaped ordering checks' >&2; exit 1 }
rg -x -F 'FAIL three captures newest first' "$output/mutant-host-results.txt"
"$driver" --cg dex --directive managed-exports --source-dir "$output/mutant-source" \
  --build-dir "$output/mutant-dex-build" --output-dir "$output" \
  "$output/mutant-source/PasteboardBehavior.idric" -o wrong-order > "$output/mutant-dex-compile.txt" 2>&1
test -s "$output/wrong-order.dex"
for log in (io.glob("$output/*compile.txt")) {
  try { rg -n '(^[[:space:]]*(Error:|INTERNAL ERROR)|compiling hole)' "$log" }
  if (_error.code !== 1) { echo "FAIL compiler diagnostics in $log" >&2; exit 1 }
}
cp "$output/behavior.dex" "$output/assets/pasteboard-behavior.dex"
git -C "$repository" rev-parse HEAD > "$output/consumer-commit.txt"
git -C "$repository" status --porcelain > "$output/consumer-dirty.txt"
git -C "$frontend" rev-parse HEAD > "$output/frontend-commit.txt"
git -C "$backend" rev-parse HEAD > "$output/backend-commit.txt"
"$compiler" --version > "$output/frontend-version.txt"
uname -a > "$output/host.txt"
sha256sum "$output/source/PasteboardBehavior.idric" "$platform_source/PasteboardPlatform.idric" \
  "$output/behavior.dex" "$output/platform.dex" "$output/wrong-order.dex" > "$output/digests.txt"
printf 'source_host\tPASS\ndirect_DEX_emission_decode_determinism\tPASS\ncompiled_order_mutant_host_rejection\tPASS\nART_execution\tNOT_VERIFIED\ninstalled_loader\tNOT_VERIFIED\n' > "$output/result.tsv"
cat "$output/result.tsv"
