#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) {
  echo 'usage: grease build-recipe-native.grease APPLICATION NDK FRESH_OUTPUT a1|c67|x86_64' >&2
  exit 2
}
var application = ARGV[0]
var ndk = ARGV[1]
var output = ARGV[2]
var target = ARGV[3]
for path in ([application, ndk, output]) {
  if (path[0] !== '/') { echo 'FAIL absolute build paths required' >&2; exit 2 }
}
test ! -e "$output"
test "$(sed -n 's/^Pkg.Revision = //p' "$ndk/source.properties")" = 29.0.14206865
var triple = 'armv7a-linux-androideabi26'
var machine = 'ARM'
if (target === 'c67') { setvar triple = 'aarch64-linux-android26'; setvar machine = 'AArch64'
} elif (target === 'x86_64') { setvar triple = 'x86_64-linux-android26'; setvar machine = 'Advanced Micro Devices X86-64'
} elif (target !== 'a1') { echo 'FAIL unknown native ABI target' >&2; exit 2 }
var toolchain = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin"
var compiler = "$toolchain/$triple-clang"
var source = "$application/green-grocer/android"
var glue = "$ndk/sources/android/native_app_glue"
var flags = ['-std=c17', '-O2', '-fPIC', '-Wall', '-Wextra', '-Werror', '-Wpedantic', '-Wshadow']
var observe = []
if (target === 'x86_64') { setvar observe = ['-DGG_RECIPE_OBSERVE=1'] }
mkdir -p "$output"
printf '\033[36mACTION\033[0m compile native recipe transport and presentation: %s\n' "$target"
for module in recipes_main canvas recipe_view recipe_engine recipe_document recipe_input {
  "$compiler" @flags @observe -isystem "$glue" -c "$source/$module.c" -o "$output/$module.o"
}
"$compiler" -std=c17 -O2 -fPIC -Wno-strict-prototypes -c "$glue/android_native_app_glue.c" -o "$output/glue.o"
"$compiler" --ld-path="$toolchain/ld.lld" -shared \
  "$output/recipes_main.o" "$output/canvas.o" "$output/recipe_view.o" \
  "$output/recipe_engine.o" "$output/recipe_document.o" "$output/recipe_input.o" "$output/glue.o" \
  -Wl,-z,defs,-z,max-page-size=16384,-z,common-page-size=4096,--build-id=sha1 \
  -Wl,-u,ANativeActivity_onCreate -landroid -llog -o "$output/libgreen_grocer.so"
"$toolchain/llvm-readobj" --elf-output-style=GNU --file-headers --program-headers \
  "$output/libgreen_grocer.so" > "$output/elf.txt"
rg -q -F "Machine:                           $machine" "$output/elf.txt"
"$toolchain/llvm-nm" -D --defined-only "$output/libgreen_grocer.so" > "$output/exports.txt"
rg -q ' T ANativeActivity_onCreate$' "$output/exports.txt"
rg -q ' T Java_org_isomorphisms_greengrocer_RecipeActivity_onActivityResult$' "$output/exports.txt"
rg -q ' T Java_org_isomorphisms_greengrocer_RecipeDocumentRequest_run$' "$output/exports.txt"
git -C "$application" rev-parse HEAD > "$output/application-revision.txt"
git -C "$application" diff --binary HEAD > "$output/local.patch"
sha256sum "$source/recipes_main.c" "$source/canvas.c" "$source/canvas.h" \
  "$source/recipe_view.c" "$source/recipe_view.h" "$source/recipe_engine.c" \
  "$source/recipe_engine.h" "$source/recipe_document.c" "$source/recipe_document.h" \
  "$source/recipe_input.c" "$source/recipe_input.h" \
  "$compiler" "$toolchain/ld.lld" "$output/libgreen_grocer.so" > "$output/digests.txt"
printf 'native_target\t%s\nNDK\t29.0.14206865\ncompile_link\tPASS\nAPK\tNOT_RUN\n' "$target" > "$output/result.tsv"
printf '\033[32mPASS\033[0m native recipe %s compile/link; APK execution remains separate\n' "$target"
