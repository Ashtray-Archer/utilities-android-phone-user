#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 10) {
  echo 'usage: grease prepare-recipe-ui.grease APPLICATION FRONTEND BACKEND GREASE TOOLS SDK NDK TEST_KEY DRIVER FRESH_OUTPUT' >&2
  exit 2
}
var application = ARGV[0]
var frontend = ARGV[1]
var backend = ARGV[2]
var grease = ARGV[3]
var tools = ARGV[4]
var sdk = ARGV[5]
var ndk = ARGV[6]
var key = ARGV[7]
var driver = ARGV[8]
var output = ARGV[9]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute UI preparation paths required' >&2; exit 2 } }
test ! -e "$output"
test "$(git -C "$frontend" rev-parse HEAD)" = 2bce7677f513d711875e978bd6f5ad28b9e54d58
test "$(git -C "$backend" rev-parse HEAD)" = f4e68eb012a69a7648ff5991cd320ec61feb5eaf
git -C "$backend" diff --quiet HEAD
mkdir -p "$output"
git -C "$application" rev-parse HEAD > "$output/application-revision.txt"
var source = "$application/examples/autogenerated/green-grocer-recipes"
var prefix = "$frontend/_/bootstrap-build"
# The checked DEX driver embeds the same pinned frontend and also retains its
# Chez generator. Use that one compiler for both host and DEX source checks.
var compiler = driver
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.IDRIS2_PATH = "$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"

proc diagnostics(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  if (_error.code !== 1) { cat "$log"; echo 'FAIL UI source diagnostics' >&2; exit 1 }
}
proc host(directory, destination) {
  mkdir -p "$destination"
  "$compiler" --cg chez --source-dir "$directory" --build-dir "$destination/build" \
    --output-dir "$destination" "$directory/RecipeScreenChecks.idric" -o checks > "$destination/compiler.txt" 2>&1
  diagnostics "$destination/compiler.txt"
  cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$destination/checks_app/"
  try { "$destination/checks" > "$destination/stdout.txt" 2> "$destination/stderr.txt" }
  var status = _error.code
  printf '%s\n' "$status" > "$destination/exit.txt"
}
proc emit(directory, module, destination, name, exports) {
  mkdir -p "$destination"
  var directives = []
  if (exports === 'yes') { setvar directives = ['--directive', 'managed-exports'] }
  "$driver" --cg dex @directives --source-dir "$directory" --build-dir "$destination/build" \
    --output-dir "$destination" "$directory/$module.idric" -o "$name" > "$destination/compiler.txt" 2>&1
  diagnostics "$destination/compiler.txt"
  test -s "$destination/$name.dex"
}
proc editor_host(directory, destination) {
  mkdir -p "$destination"
  "$compiler" --cg chez --source-dir "$directory" --build-dir "$destination/build" \
    --output-dir "$destination" "$directory/RecipeEditorChecks.idric" -o checks > "$destination/compiler.txt" 2>&1
  diagnostics "$destination/compiler.txt"
  cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$destination/checks_app/"
  try { "$destination/checks" > "$destination/stdout.txt" 2> "$destination/stderr.txt" }
  var status = _error.code
  printf '%s\n' "$status" > "$destination/exit.txt"
}

host "$source" "$output/host"
cat "$output/host/stdout.txt"
test "$(cat "$output/host/exit.txt")" = 0
rg -x -F 'recipe_screen_checks 16' "$output/host/stdout.txt"
emit "$source" RecipeScreenChecks "$output/checks" checks no
editor_host "$source" "$output/editor-host"
cat "$output/editor-host/stdout.txt"
test "$(cat "$output/editor-host/exit.txt")" = 0
rg -x -F 'recipe_editor_checks 37' "$output/editor-host/stdout.txt"
emit "$source" RecipeEditorChecks "$output/editor-checks" checks no
for mutation in stale decimal {
  var directory = "$output/editor-$mutation-source"
  mkdir -p "$directory"
  cp -R "$source/." "$directory/"
  var assertion = 'FAIL old keyboard connection cannot write to another field'
  if (mutation === 'stale') {
    sed 's/expected ≟ "" || not (expected ≟ input_target session)/expected ≟ ""/' \
      "$source/RecipeEditor.idric" > "$directory/RecipeEditor.idric"
    if cmp -s "$source/RecipeEditor.idric" "$directory/RecipeEditor.idric" { echo 'FAIL unchanged stale input mutation' >&2; exit 1 }
  } else {
    sed 's/scale × 10/scale × 2/' "$source/RecipeDraft.idric" > "$directory/RecipeDraft.idric"
    if cmp -s "$source/RecipeDraft.idric" "$directory/RecipeDraft.idric" { echo 'FAIL unchanged decimal mutation' >&2; exit 1 }
    setvar assertion = 'FAIL decimal quantity stays exact'
  }
  editor_host "$directory" "$output/editor-$mutation-host"
  test "$(cat "$output/editor-$mutation-host/exit.txt")" = 1
  rg -x -F "$assertion" "$output/editor-$mutation-host/stdout.txt"
  emit "$directory" RecipeEditorChecks "$output/editor-mutant-$mutation" checks no
  if cmp -s "$output/editor-checks/checks.dex" "$output/editor-mutant-$mutation/checks.dex" { echo 'FAIL unchanged editor mutant DEX' >&2; exit 1 }
  printf '%s\n' "$assertion" > "$output/editor-mutant-$mutation/assertion.txt"
}
emit "$source" RecipeNative "$output/recipes" recipes yes
emit "$source" RecipeNative "$output/recipes-repeat" recipes yes
cmp "$output/recipes/recipes.dex" "$output/recipes-repeat/recipes.dex"

for mutation in pantry navigation review {
  var directory = "$output/$mutation-source"
  mkdir -p "$directory"
  cp -R "$source/." "$directory/"
  var assertion = 'FAIL pantry touch subtracts from combined demand'
  if (mutation === 'pantry') {
    sed 's/pantry_step _ = 100/pantry_step _ = 0/' "$source/RecipeScreen.idric" > "$directory/RecipeScreen.idric"
  } elif (mutation === 'navigation') {
    sed 's/Right \["ingredients"\] ⇒ transition (go_to ingredients_screen) state/Right ["ingredients"] ⇒ transition (go_to recipes_screen) state/' \
      "$source/RecipeScreen.idric" > "$directory/RecipeScreen.idric"
    setvar assertion = 'FAIL ingredient navigation exposes the planned screen'
  } else {
    sed 's/Right \["approve-review"\] ⇒ transition approve_review state/Right ["approve-review"] ⇒ { review_approved := True } state/' \
      "$source/RecipeScreen.idric" > "$directory/RecipeScreen.idric"
    setvar assertion = 'FAIL missing store refuses cart approval'
  }
  if cmp -s "$source/RecipeScreen.idric" "$directory/RecipeScreen.idric" { echo 'FAIL unchanged screen mutation' >&2; exit 1 }
  host "$directory" "$output/$mutation-host"
  test "$(cat "$output/$mutation-host/exit.txt")" = 1
  rg -x -F "$assertion" "$output/$mutation-host/stdout.txt"
  emit "$directory" RecipeScreenChecks "$output/mutant-$mutation" checks no
  if cmp -s "$output/checks/checks.dex" "$output/mutant-$mutation/checks.dex" { echo 'FAIL unchanged mutant DEX' >&2; exit 1 }
  printf '%s\n' "$assertion" > "$output/mutant-$mutation/assertion.txt"
}

# The native callback classes are emitted by the backend's checked generic
# framework plan. Smali only inspects them; it never produces application DEX.
mkdir -p "$output/callback-source" "$output/callback"
cp -R "$backend/dex/idric/src/Backend" "$output/callback-source/"
cp "$source/RecipeActivityPlan.idric" "$output/callback-source/"
"$compiler" --cg chez --source-dir "$output/callback-source" --build-dir "$output/callback/build" \
  --output-dir "$output/callback" "$output/callback-source/RecipeActivityPlan.idric" -o plan > "$output/callback/compiler.txt" 2>&1
diagnostics "$output/callback/compiler.txt"
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$output/callback/plan_app/"
"$output/callback/plan" "$output/callback/classes.dex" > "$output/callback/result.txt"
"$output/callback/plan" "$output/callback/repeat.dex" > "$output/callback/repeat.txt"
cmp "$output/callback/classes.dex" "$output/callback/repeat.dex"
java -jar "$tools/baksmali.jar" disassemble "$output/callback/classes.dex" -o "$output/callback/decoded"
rg -x -F '.super Landroid/app/NativeActivity;' "$output/callback/decoded/org/isomorphisms/greengrocer/RecipeActivity.smali"
rg -x -F '.method public native onActivityResult(IILandroid/content/Intent;)V' "$output/callback/decoded/org/isomorphisms/greengrocer/RecipeActivity.smali"
rg -x -F '.implements Ljava/lang/Runnable;' "$output/callback/decoded/org/isomorphisms/greengrocer/RecipeDocumentRequest.smali"
rg -F 'Ljava/lang/System;->loadLibrary(Ljava/lang/String;)V' "$output/callback/decoded/org/isomorphisms/greengrocer/RecipeActivity.smali"
rg -x -F '.method public constructor <init>(Landroid/content/Context;)V' "$output/callback/decoded/org/isomorphisms/greengrocer/RecipeInputView.smali"
rg -x -F '.method public constructor <init>(Landroid/view/View;Z)V' "$output/callback/decoded/org/isomorphisms/greengrocer/RecipeInputConnection.smali"
rg -x -F '.method public native getEditable()Landroid/text/Editable;' "$output/callback/decoded/org/isomorphisms/greengrocer/RecipeInputConnection.smali"
rg -x -F '.method public native replaceText(IILjava/lang/CharSequence;ILandroid/view/inputmethod/TextAttribute;)Z' "$output/callback/decoded/org/isomorphisms/greengrocer/RecipeModernInputConnection.smali"

var native_compiler = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/x86_64-linux-android26-clang"
var native_source = "$application/green-grocer/android"
"$native_compiler" -std=c17 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow \
  "$native_source/recipe_view.c" "$native_source/recipe_view_test.c" -o "$output/view-check"
mkdir -p "$output/view-mutant-source"
sed 's/if (character >= 0xD800 \&\& character <= 0xDBFF)/if (false)/' \
  "$native_source/recipe_view.c" > "$output/view-mutant-source/recipe_view.c"
if cmp -s "$native_source/recipe_view.c" "$output/view-mutant-source/recipe_view.c" { echo 'FAIL unchanged UTF-16 transport mutant' >&2; exit 1 }
"$native_compiler" -std=c17 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -I "$native_source" \
  "$output/view-mutant-source/recipe_view.c" "$native_source/recipe_view_test.c" -o "$output/view-mutant"
if cmp -s "$output/view-check" "$output/view-mutant" { echo 'FAIL unchanged native transport mutant bytes' >&2; exit 1 }

for target in x86_64 a1 c67 {
  "$grease" "$application/green-grocer/_/build-recipe-native.grease" "$application" "$ndk" "$output/native-$target" "$target"
  "$grease" "$application/green-grocer/_/package-recipes.grease" "$application" "$backend" "$sdk" "$key" \
    "$tools/baksmali.jar" "$grease" "$output/native-$target" "$output/recipes/recipes.dex" \
    "$output/callback/classes.dex" "$output/apk-$target" "$target"
}
"$grease" "$application/green-grocer/_/package-recipe-observer.grease" \
  "$application" "$sdk" "$tools/smali.jar" "$key" "$compiler" "$frontend" "$output/observer"
sha256sum "$source/RecipeSession.idric" "$source/RecipeScreen.idric" "$source/RecipeNative.idric" \
  "$source/RecipeText.idric" "$source/RecipeDraft.idric" "$source/RecipeEditorSession.idric" \
  "$source/RecipeEditorScreen.idric" "$source/RecipeEditor.idric" "$source/RecipeEditorChecks.idric" \
  "$source/RecipeScreenChecks.idric" "$source/RecipeActivityPlan.idric" \
  "$output/recipes/recipes.dex" "$output/checks/checks.dex" "$output/callback/classes.dex" \
  "$output/view-check" "$output/view-mutant" > "$output/digests.txt"
printf 'recipe_screen_host\t16_PASS\nrecipe_editor_host\t37_PASS\neditor_mutants\t2_HOST_REJECTED_AND_DEX_COMPILED\nUI_mutants\t3_COMPILED\nnative_transport_mutant\tCOMPILED\nrecipe_ABIs\ta1_c67_x86_64_BUILT\nrecipe_APKs\tSTABLE_TEST_SIGNER_PASS\ninstalled_recipe_UI\tNOT_RUN\ninstalled_recipe_editor\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m checked recipe UI, source mutation controls, native boundary and three signed APK candidates prepared\n'
cd "$output"
sha256sum checks/checks.dex recipes/recipes.dex callback/classes.dex host/stdout.txt \
  editor-checks/checks.dex editor-host/stdout.txt \
  editor-mutant-stale/checks.dex editor-mutant-stale/assertion.txt \
  editor-mutant-decimal/checks.dex editor-mutant-decimal/assertion.txt \
  mutant-pantry/checks.dex mutant-pantry/assertion.txt \
  mutant-navigation/checks.dex mutant-navigation/assertion.txt \
  mutant-review/checks.dex mutant-review/assertion.txt view-check view-mutant \
  observer/archive/classes.dex observer/recipe-observer.apk observer/assets/fixture.recipe \
  observer/assets/expected/imported.view observer/assets/edit-new.recipe observer/assets/edit-updated.recipe \
  observer/assets/expected/edit-cold.view \
  apk-x86_64/green-grocer-recipes-x86_64.apk apk-a1/green-grocer-recipes-a1.apk \
  apk-c67/green-grocer-recipes-c67.apk > artifacts.sha256
