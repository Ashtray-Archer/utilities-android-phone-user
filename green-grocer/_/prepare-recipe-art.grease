#!/usr/bin/env grease

if (len(ARGV) !== 6) {
  echo 'usage: grease prepare-recipe-art.grease APPLICATION FRONTEND BACKEND GREASE SMALI_JAR NEW_OUTPUT' >&2
  exit 2
}
var application = ARGV[0]
var frontend = ARGV[1]
var backend = ARGV[2]
var grease = ARGV[3]
var smali = ARGV[4]
var output = ARGV[5]
for path in ([application, frontend, backend, grease, smali, output]) {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
test ! -e "$output"
test "$(git -C "$backend" rev-parse HEAD)" = dfcf2cb22c0ebcc4ce999189cc2f066593bf3689
git -C "$backend" diff --quiet HEAD
mkdir -p "$output"
git -C "$application" rev-parse HEAD > "$output/application-revision.txt"
"$grease" "$application/green-grocer/_/check-recipes.grease" "$application" "$frontend" "$output/host"
"$grease" "$application/green-grocer/_/check-recipe-storage.grease" "$application" "$frontend" "$output/storage-host"
"$grease" "$backend/examples/autogenerated/source-loop-values/build-driver.grease" \
  "$backend" "$frontend" "$frontend/_/.tools/bin/scheme" "$output/driver"
var driver = "$output/driver/exec/idric-dex"
"$grease" "$application/green-grocer/_/check-recipe-dex.grease" "$application" "$frontend" "$driver" "$output/probes"
var source = "$application/examples/autogenerated/green-grocer-recipes"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.IDRIS2_PATH = "$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"

proc emit(directory, name, module) {
  mkdir -p "$output/$name"
  "$driver" --cg dex --source-dir "$directory" --build-dir "$output/$name/build" \
    --output-dir "$output/$name" "$directory/$module.idric" -o checks \
    > "$output/$name/compiler.txt" 2>&1
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/$name/compiler.txt" {
    echo "FAIL DEX diagnostics in $name" >&2; exit 1
  }
  test -s "$output/$name/checks.dex"
  sha256sum "$output/$name/checks.dex" > "$output/$name/digest.txt"
}
emit "$source" positive RecipeShoppingChecks
for mutation in pantry rounding price source store grouping {
  emit "$output/host/$mutation-source" "mutant-$mutation" RecipeShoppingChecks
  if cmp -s "$output/positive/checks.dex" "$output/mutant-$mutation/checks.dex" {
    echo "FAIL DEX mutation retained candidate bytes: $mutation" >&2; exit 1
  }
}
emit "$source" storage RecipeStorageChecks
for mutation in sources rational trailing {
  emit "$output/storage-host/$mutation-source" "storage-mutant-$mutation" RecipeStorageChecks
  if cmp -s "$output/storage/checks.dex" "$output/storage-mutant-$mutation/checks.dex" {
    echo "FAIL storage DEX mutation retained candidate bytes: $mutation" >&2; exit 1
  }
}
printf '32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a  %s\n' "$smali" | sha256sum -c -
java -jar "$smali" assemble "$source/RecipeRuntimeObserver.smali" -o "$output/observer.dex"
sha256sum "$output/observer.dex" "$source/RecipeRuntimeObserver.smali" > "$output/observer-digests.txt"

proc emit_files(directory, name) {
  mkdir -p "$output/$name"
  "$driver" --cg dex --directive managed-exports --source-dir "$directory" \
    --build-dir "$output/$name/build" --output-dir "$output/$name" \
    "$directory/RecipeFileProbe.idric" -o files > "$output/$name/compiler.txt" 2>&1
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/$name/compiler.txt" {
    echo 'FAIL recipe file DEX diagnostics' >&2; exit 1
  }
  test -s "$output/$name/files.dex"
  sha256sum "$directory/RecipeFiles.idric" "$directory/RecipeFilePlatform.idric" \
    "$directory/RecipeFileProbe.idric" "$output/$name/files.dex" > "$output/$name/digests.txt"
}
emit_files "$source" files
var directory = "$output/files-lenient-source"
mkdir -p "$directory"
cp -R "$source/." "$directory/"
sed -e 's@Ljava/nio/charset/CharsetDecoder;)V@Ljava/nio/charset/Charset;)V@' \
  -e 's/strict_reader : InputStreamReference → DecoderReference/strict_reader : InputStreamReference → CharsetReference/' \
  -e 's/(input_stream stream) decoder/(input_stream stream) charset/' \
  "$source/RecipeFilePlatform.idric" > "$directory/RecipeFilePlatform.idric"
if cmp -s "$source/RecipeFilePlatform.idric" "$directory/RecipeFilePlatform.idric" {
  echo 'FAIL UTF-8 mutation did not change the reader' >&2; exit 1
}
emit_files "$directory" files-lenient
if cmp -s "$output/files/files.dex" "$output/files-lenient/files.dex" {
  echo 'FAIL lenient UTF-8 mutant retained candidate bytes' >&2; exit 1
}
setvar directory = "$output/files-unreported-source"
mkdir -p "$directory"
cp -R "$source/." "$directory/"
sed 's/if reference_is_null (failure_object failure) ≟ 0/if False/' \
  "$source/RecipeFilePlatform.idric" > "$directory/RecipeFilePlatform.idric"
if cmp -s "$source/RecipeFilePlatform.idric" "$directory/RecipeFilePlatform.idric" {
  echo 'FAIL I/O error mutation did not change the reader' >&2; exit 1
}
emit_files "$directory" files-unreported
if cmp -s "$output/files/files.dex" "$output/files-unreported/files.dex" {
  echo 'FAIL unreported I/O mutant retained candidate bytes' >&2; exit 1
}
java -jar "$smali" assemble "$source/RecipeFileObserver.smali" -o "$output/file-observer.dex"
sha256sum "$output/file-observer.dex" "$source/RecipeFileObserver.smali" > "$output/file-observer-digests.txt"
printf 'host_semantics\tPASS\nsource_to_dex\tPASS\ncompiled_mutants\t11\nART\tNOT_RUN\n' > "$output/preparation.tsv"
printf '\033[32mPASS\033[0m recipes, file operations, host controls, direct DEX and eleven compiled mutants prepared\n'
