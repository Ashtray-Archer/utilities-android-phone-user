#!/usr/bin/env grease

# Host semantic controls only. An Android executable is a separate required
# boundary, exercised by check-recipe-dex.grease once a current driver exists.
if (len(ARGV) !== 3) {
  echo 'usage: grease check-recipes.grease ABS_REPOSITORY ABS_IDRIC ABS_NEW_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var output = ARGV[2]
for path in ([repository, frontend, output]) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused evidence directory' >&2; exit 1 }
test "$(git -C "$frontend" rev-parse HEAD)" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
git -C "$frontend" diff --quiet HEAD
var compiler = "$frontend/_/build/exec/idris2"
var scheme = "$frontend/_/.tools/bin/scheme"
var support = "$frontend/_/build/exec/idris2_app/libidris2_support.so"
var prefix = "$frontend/_/bootstrap-build"
var modules = "$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0"
var source = "$repository/examples/autogenerated/green-grocer-recipes"
for program in ([compiler, scheme]) { test -x "$program" }
test -s "$support"
mkdir -p "$output"
git -C "$repository" rev-parse HEAD > "$output/application-parent.txt"
git -C "$repository" status --short > "$output/application-status.txt"
git -C "$frontend" rev-parse HEAD > "$output/frontend-revision.txt"
sha256sum "$compiler" "$frontend/_/build/exec/idris2_app/idris2.so" \
  "$source/RecipeShopping.idric" "$source/RecipeShoppingChecks.idric" \
  "$source/RecipeRuntime.idric" > "$output/input-sha256.txt"

proc compile_host(directory, main, name) {
  mkdir -p "$output/$name"
  env IDRIS2_PREFIX="$prefix" IDRIS2_DATA="$frontend/_/support" \
    IDRIS2_LIBS="$frontend/_/build/exec/idris2_app" IDRIS2_PATH="$modules" CHEZ="$scheme" \
    "$compiler" --cg chez --source-dir "$directory" --build-dir "$output/$name/build" \
    --output-dir "$output/$name" "$directory/$main" -o "$name" \
    > "$output/$name/compile.txt" 2>&1
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/$name/compile.txt" {
    echo 'FAIL host compilation reported an error' >&2; exit 1
  }
  test -x "$output/$name/$name"
  cp "$support" "$output/$name/${name}_app/"
}

printf '\033[36mACTION\033[0m Execute checked Idric recipe decisions\n'
compile_host "$source" RecipeShoppingChecks.idric recipes
env CHEZ="$scheme" "$output/recipes/recipes" > "$output/recipes/execution.txt" 2>&1
cat "$output/recipes/execution.txt"
rg -q -x -F 'PASS Idric recipe shopping host semantics' "$output/recipes/execution.txt"

compile_host "$source" RecipeRuntime.idric runtime-control
env CHEZ="$scheme" "$output/runtime-control/runtime-control" > "$output/runtime-control/execution.txt" 2>&1
printf '0\n1\n2\n2\nUser-entered soup\nRecipe needs an identity and name\n' > "$output/runtime-control/expected.txt"
cmp "$output/runtime-control/expected.txt" "$output/runtime-control/execution.txt"

# Change the actual implementation, compile it, and require a behavioral
# failure at the expected independent test. A compiler refusal is not enough.
for mutation in pantry rounding price {
  var directory = "$output/$mutation-source"
  mkdir -p "$directory"
  cp "$source/RecipeShoppingChecks.idric" "$directory/"
  if (mutation === 'pantry') {
    sed 's/in AfterPantry required owned (subtract_owned required.required_amount owned)/in AfterPantry required owned required.required_amount/' \
      "$source/RecipeShopping.idric" > "$directory/RecipeShopping.idric"
  } elif (mutation === 'rounding') {
    sed 's/divNatNZ (top + bottom_less_one)/divNatNZ top/' \
      "$source/RecipeShopping.idric" > "$directory/RecipeShopping.idric"
  } else {
    sed 's/if current ≟ previous then Right product else Left price_changed/if True then Right product else Left price_changed/' \
      "$source/RecipeShopping.idric" > "$directory/RecipeShopping.idric"
  }
  if cmp -s "$source/RecipeShopping.idric" "$directory/RecipeShopping.idric" {
    echo 'FAIL mutation did not change source' >&2; exit 1
  }
  compile_host "$directory" RecipeShoppingChecks.idric "mutant-$mutation"
  try { env CHEZ="$scheme" "$output/mutant-$mutation/mutant-$mutation" > "$output/mutant-$mutation/execution.txt" 2>&1 }
  var status = _error.code
  if (status !== 1) { echo "FAIL expected semantic rejection of $mutation mutant" >&2; exit 1 }
  var diagnostic = 'FAIL pantry reduces demand and preserves all product identifiers'
  if (mutation === 'rounding') { setvar diagnostic = 'FAIL 500 g selects two 300 g packages and 100 g surplus' }
  if (mutation === 'price') { setvar diagnostic = 'FAIL changed price requires approval' }
  rg -q -x -F "$diagnostic" "$output/mutant-$mutation/execution.txt"
  printf '\033[32mPASS\033[0m rejected executed %s mutation\n' "$mutation"
}
printf 'host_semantics\tPASS\nruntime_probe_host\tPASS\nsemantic_mutants\tPASS\nc_oracle_execution\tNOT_RUN\nandroid_art\tNOT_RUN\nphysical_a1\tNOT_RUN\nphysical_c67\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m Idric host semantics; Android, C oracle and physical acceptance remain separate\n'
