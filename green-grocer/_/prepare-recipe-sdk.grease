#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 2) { echo 'usage: grease prepare-recipe-sdk.grease SDK FRESH_SIGNER_DIRECTORY' >&2; exit 2 }
var sdk = ARGV[0]
var output = ARGV[1]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute SDK inputs required' >&2; exit 2 } }
test ! -e "$output"
var manager = "$sdk/cmdline-tools/latest/bin/sdkmanager"
test -x "$manager"
"$manager" 'platforms;android-36' 'build-tools;36.0.0' 'ndk;29.0.14206865' < /dev/null
mkdir -p "$output"
curl -fL --retry 3 https://raw.githubusercontent.com/isomorphismes/wegert/89dcfb840cec1a66ee04c7f7404954cbd6c09839/_/build/app/wegert-debug.keystore \
  -o "$output/wegert-debug.keystore"
keytool -list -v -keystore "$output/wegert-debug.keystore" -storepass wegert-debug -alias wegert-debug \
  > "$output/signer.txt"
rg -F 'DE:9B:1D:47:C5:A6:5E:6D:46:A2:04:B7:9D:D9:EE:56:6B:9D:3C:98:32:BA:81:EB:C4:21:3D:33:92:E9:2F:F9' "$output/signer.txt"
