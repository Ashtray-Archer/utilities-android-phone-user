#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 2) {
  echo 'usage: grease stage-storefront-sources.grease APPLICATION FRESH_SOURCE_DIRECTORY' >&2
  exit 2
}
var application = ARGV[0]
var source = ARGV[1]
test ! -e "$source"
cp -R "$application/examples/autogenerated/green-grocer-recipes" "$source"
var tables = "$application/green-grocer/storefront"
awk -f "$application/green-grocer/_/storefront-fixtures.awk" \
  "$tables/catalog.tsv" "$tables/purchases.tsv" > "$source/StorefrontFixtures.idric"
