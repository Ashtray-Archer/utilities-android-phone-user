#!/usr/bin/env grease

if (len(ARGV) !== 3) { echo 'usage: grease check-recipe-storage.grease APPLICATION FRONTEND NEW_OUTPUT' >&2; exit 2 }
var application = ARGV[0]
var frontend = ARGV[1]
var output = ARGV[2]
for path in ([application, frontend, output]) {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
test ! -e "$output"
test "$(git -C "$frontend" rev-parse HEAD)" = 2bce7677f513d711875e978bd6f5ad28b9e54d58
git -C "$frontend" diff --quiet HEAD
var compiler = "$frontend/_/build/exec/idris2"
var prefix = "$frontend/_/bootstrap-build"
var scheme = "$frontend/_/.tools/bin/scheme"
var source = "$application/examples/autogenerated/green-grocer-recipes"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.IDRIS2_PATH = "$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0"
setglobal ENV.CHEZ = scheme
mkdir -p "$output"
git -C "$application" rev-parse HEAD > "$output/application-parent.txt"
sha256sum "$source/RecipeShopping.idric" "$source/RecipeStorage.idric" \
  "$source/RecipeStorageChecks.idric" "$compiler" "${compiler}_app/idris2.so" > "$output/inputs.sha256"
proc compile(directory, name) {
  mkdir -p "$output/$name"
  "$compiler" --cg chez --source-dir "$directory" --build-dir "$output/$name/build" \
    --output-dir "$output/$name" "$directory/RecipeStorageChecks.idric" -o checks \
    > "$output/$name/compiler.txt" 2>&1
  if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/$name/compiler.txt" {
    echo "FAIL storage compilation: $name" >&2; exit 1
  }
  test -x "$output/$name/checks"
  cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$output/$name/checks_app/"
}
compile "$source" positive
"$output/positive/checks" > "$output/positive/execution.txt" 2>&1
cat "$output/positive/execution.txt"
rg -x -F 'PASS Idric recipe storage semantics' "$output/positive/execution.txt"
for mutation in sources rational trailing {
  var directory = "$output/$mutation-source"
  mkdir -p "$directory"
  cp "$source/RecipeShopping.idric" "$source/RecipeStorageChecks.idric" "$directory/"
  if (mutation === 'sources') {
    sed 's/source_fields source = \[source.source_link, source.source_note\]/source_fields source = [source.source_link, ""]/' \
      "$source/RecipeStorage.idric" > "$directory/RecipeStorage.idric"
  } elif (mutation === 'rational') {
    sed 's/show (denominator ingredient.ingredient_measure.base_amount)/show (denominator (whole 1))/' \
      "$source/RecipeStorage.idric" > "$directory/RecipeStorage.idric"
  } else {
    sed 's/if not (null trailing) then Left "Trailing recipe fields" else do/if False then Left "Trailing recipe fields" else do/' \
      "$source/RecipeStorage.idric" > "$directory/RecipeStorage.idric"
  }
  if cmp -s "$source/RecipeStorage.idric" "$directory/RecipeStorage.idric" {
    echo 'FAIL storage mutation did not change source' >&2; exit 1
  }
  compile "$directory" "mutant-$mutation"
  try { "$output/mutant-$mutation/checks" > "$output/mutant-$mutation/execution.txt" 2>&1 }
  if (_error.code !== 1) { echo "FAIL storage mutation did not fail behavior: $mutation" >&2; exit 1 }
  var diagnostic = 'FAIL saved sources preserve exact links Unicode whitespace and notes'
  if (mutation === 'rational') { setvar diagnostic = 'FAIL decoded ingredient quantities dimensions and identities are exact' }
  if (mutation === 'trailing') { setvar diagnostic = 'FAIL trailing fields are refused' }
  rg -x -F "$diagnostic" "$output/mutant-$mutation/execution.txt"
}
printf 'recipe_storage_host\tPASS\nchecks\t24\ncompiled_mutants\t3_REJECTED\nAndroid_file_IO\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m exact recipe files, refusal-state preservation and three executed storage mutants\n'
