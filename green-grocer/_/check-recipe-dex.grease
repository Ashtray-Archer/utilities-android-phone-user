#!/usr/bin/env grease

# This is a REQUIRED failing acceptance while the compiler lacks the numeric
# runtime. It must not turn an expected diagnostic into an application PASS.
if (len(ARGV) !== 4) {
  echo 'usage: grease check-recipe-dex.grease ABS_REPOSITORY ABS_IDRIC ABS_DEX_DRIVER ABS_NEW_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var output = ARGV[3]
for path in ([repository, frontend, driver, output]) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused evidence directory' >&2; exit 1 }
test "$(git -C "$frontend" rev-parse HEAD)" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
test -x "$driver"
var prefix = "$frontend/_/bootstrap-build"
var modules = "$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0"
var source = "$repository/examples/autogenerated/green-grocer-recipes"
mkdir -p "$output"
sha256sum "$driver" "$source/RecipeShopping.idric" "$source/RecipeRuntime.idric" > "$output/input-sha256.txt"
printf '\033[36mACTION\033[0m Compile actual Idric recipe runtime through direct DEX\n'
try {
  env IDRIS2_PREFIX="$prefix" IDRIS2_DATA="$frontend/_/support" \
    IDRIS2_LIBS="$frontend/_/build/exec/idris2_app" IDRIS2_PATH="$modules" \
    CHEZ="$frontend/_/.tools/bin/scheme" \
    "$driver" --cg dex --source-dir "$source" --build-dir "$output/build" \
    --output-dir "$output" "$source/RecipeRuntime.idric" -o recipes \
    > "$output/compile.txt" 2>&1
}
var status = _error.code
cat "$output/compile.txt"
printf 'compiler_exit\t%s\n' "$status" > "$output/result.tsv"
if (status !== 0) {
  printf 'dex_emission\tFAIL\nart_execution\tNOT_RUN\napk_acceptance\tNOT_RUN\n' >> "$output/result.tsv"
  printf '\033[31mFAIL\033[0m direct DEX cannot execute the required recipe arithmetic\n' >&2
  exit 1
}
if rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/compile.txt" {
  echo 'FAIL driver printed an error despite zero exit' >&2; exit 1
}
test -s "$output/recipes.dex"
sha256sum "$output/recipes.dex" > "$output/dex-sha256.txt"
printf 'dex_emission\tPASS\nart_execution\tNOT_RUN\napk_acceptance\tNOT_RUN\n' >> "$output/result.tsv"
printf '\033[32mPASS\033[0m DEX emission only; actual ART observation and APK acceptance still required\n'
