#!/usr/bin/env grease

if (len(ARGV) !== 4) { echo 'usage: grease observe-recipe-art.grease ADB SERIAL INPUT NEW_OUTPUT' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var input = ARGV[2]
var output = ARGV[3]
for path in ([adb, input, output]) {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
test ! -e "$output"
mkdir -p "$output"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
"$adb" -s "$serial" shell getprop ro.build.version.sdk > "$output/api.txt"
"$adb" -s "$serial" shell getprop ro.build.fingerprint > "$output/fingerprint.txt"
cp "$input/application-revision.txt" "$output/"
var remote = '/data/local/tmp/greengrocer-recipe-acceptance'
"$adb" -s "$serial" shell mkdir -p "$remote"
proc transfer(local, name) {
  "$adb" -s "$serial" push "$local" "$remote/$name.dex"
  "$adb" -s "$serial" pull "$remote/$name.dex" "$output/$name-received.dex"
  cmp "$local" "$output/$name-received.dex"
  sha256sum "$local" >> "$output/artifact-digests.txt"
}
transfer "$input/positive/checks.dex" positive
transfer "$input/probes/recipes.dex" probes
transfer "$input/observer.dex" observer
for mutation in pantry rounding price source store grouping {
  transfer "$input/mutant-$mutation/checks.dex" "mutant-$mutation"
}
proc execute(name, classpath, class) {
  try {
    timeout 120 "$adb" -s "$serial" shell -T \
      "CLASSPATH=$classpath app_process /system/bin $class" \
      > "$output/$name.stdout" 2> "$output/$name.stderr"
  }
  var status = _error.code
  printf '%s\n' "$status" > "$output/$name.exit"
  cat "$output/$name.stdout"
}
execute positive "$remote/positive.dex" Idric.Generated
test "$(cat "$output/positive.exit")" = 0
cmp "$input/host/recipes/execution.txt" "$output/positive.stdout"
execute probes "$remote/probes.dex:$remote/observer.dex" acceptance.RecipeRuntimeObserver
test "$(cat "$output/probes.exit")" = 0
rg -x -F 'PASS changing recipe runtime inputs on ART' "$output/probes.stdout"
for mutation in pantry rounding price source store grouping {
  execute "mutant-$mutation" "$remote/mutant-$mutation.dex" Idric.Generated
  test "$(cat "$output/mutant-$mutation.exit")" = 1
  cmp "$input/host/mutant-$mutation/execution.txt" "$output/mutant-$mutation.stdout"
}
printf 'recipe_checks_ART\tPASS\nrecipe_checks\t51\nchanging_export_inputs_ART\tPASS\ncompiled_semantic_mutants\t6_REJECTED\nrecipe_APK\tNOT_RUN\nphysical_A1\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m complete recipe checks and six semantic mutants on x86_64 ART\n'
