#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) {
  echo 'usage: grease package-recipe-observer.grease APPLICATION SDK SMALI TEST_KEY HOST_COMPILER FRONTEND FRESH_OUTPUT' >&2
  exit 2
}
var application = ARGV[0]
var sdk = ARGV[1]
var smali = ARGV[2]
var key = ARGV[3]
var compiler = ARGV[4]
var frontend = ARGV[5]
var output = ARGV[6]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute observer paths required' >&2; exit 2 } }
test ! -e "$output"
mkdir -p "$output/assets/expected" "$output/host" "$output/archive"
var source = "$application/examples/autogenerated/green-grocer-recipes"
var prefix = "$frontend/_/bootstrap-build"
env IDRIS2_PREFIX="$prefix" IDRIS2_DATA="$frontend/_/support" \
  IDRIS2_LIBS="$frontend/_/build/exec/idris2_app" \
  IDRIS2_PATH="$prefix/idris2-0.8.0/base-0.8.0:$prefix/idris2-0.8.0/prelude-0.8.0" \
  CHEZ="$frontend/_/.tools/bin/scheme" \
  "$compiler" --cg chez --source-dir "$source" --build-dir "$output/host/build" \
    --output-dir "$output/host" "$source/RecipeScreenReceipt.idric" -o receipt > "$output/host/compiler.txt" 2>&1
try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$output/host/compiler.txt" }
if (_error.code !== 1) { cat "$output/host/compiler.txt"; exit 1 }
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$output/host/receipt_app/"
"$output/host/receipt" "$output/assets" > "$output/host/result.txt"
cat "$output/host/result.txt"
# An independent byte literal catches truncation at the host C-string boundary.
# The final source note contains an actual NUL followed by five more characters.
printf '22:green-grocer-recipe-v14:soup7:Soup λ🦉1:21:14:rice4:Rice4:mass3:5001:15:rinse1:01:131:https://example.org/source#t=809:食事\n\000notes' \
  > "$output/expected-fixture.recipe"
cmp "$output/expected-fixture.recipe" "$output/assets/fixture.recipe"
java -jar "$smali" assemble "$application/green-grocer/acceptance" -o "$output/archive/classes.dex"
var tools = "$sdk/build-tools/36.0.0"
"$tools/dexdump" -c "$output/archive/classes.dex" > "$output/dex-integrity.txt"
"$tools/aapt2" link -o "$output/observer-resource.apk" -I "$sdk/platforms/android-36/android.jar" \
  --manifest "$application/green-grocer/acceptance/AndroidManifest.xml" -A "$output/assets"
cp "$output/observer-resource.apk" "$output/observer-unaligned.apk"
cd "$output/archive"
zip -X -q "$output/observer-unaligned.apk" classes.dex
"$tools/zipalign" -f -p 4 "$output/observer-unaligned.apk" "$output/observer-aligned.apk"
"$tools/apksigner" sign --ks "$key" --ks-key-alias wegert-debug --ks-pass pass:wegert-debug \
  --key-pass pass:wegert-debug --out "$output/recipe-observer.apk" "$output/observer-aligned.apk"
"$tools/apksigner" verify --verbose --print-certs "$output/recipe-observer.apk" > "$output/signature.txt"
rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$output/signature.txt"
git -C "$application" rev-parse HEAD > "$output/application-revision.txt"
sha256sum "$application/green-grocer/acceptance/RecipeObserver.smali" \
  "$application/green-grocer/acceptance/RecipeDeliver.smali" \
  "$application/green-grocer/acceptance/RecipeViewHash.smali" \
  "$application/green-grocer/acceptance/RecipeScreenshotCheck.smali" \
  "$source/RecipeScreenReceipt.idric" "$output/archive/classes.dex" "$output/recipe-observer.apk" \
  > "$output/digests.txt"
printf '\033[32mPASS\033[0m independent SDK observer APK and checked host projection receipts prepared\n'
