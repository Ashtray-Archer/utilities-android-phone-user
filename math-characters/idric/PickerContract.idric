module PickerContract

import UnicodePicker

%default total

count_text : String → List String → Nat
count_text _ [] = 0
count_text wanted (actual :: rest) =
  (if wanted == actual then 1 else 0) + count_text wanted rest

outputs : List PickerKey → List String
outputs [] = []
outputs (key :: rest) =
  case inserted_text (key_action key) of
    Nothing ⇒ outputs rest
    Just text ⇒ text :: outputs rest

page_names : List String
page_names = map page_name pages

key_labels : List String
key_labels = map key_label (all_keys pages)

inserted_outputs : List String
inserted_outputs = outputs (all_keys pages)

contract_holds : Bool
contract_holds =
  slot_index slot_one == 0 &&
  slot_index slot_two == 1 &&
  slot_index slot_three == 2 &&
  page_names ==
    [ "Unicode", "Math", "Punctuation", "Programming"
    , "Regular Expressions", "Concept Separation"
    , "Incantation Assistance", "Several Pastebins"
    ] &&
  not (elem "Movement" page_names) &&
  not (elem "Signals" page_names) &&
  not (elem "CHANT\nHISTORY" key_labels) &&
  not (elem "-" inserted_outputs) &&
  elem "⟵\nASSIGN" key_labels &&
  count_text "λ" inserted_outputs >= 2 &&
  count_text "←" inserted_outputs >= 2 &&
  count_text "⟵" inserted_outputs >= 2 &&
  count_text "→" inserted_outputs >= 3

main : IO ()
main =
  if contract_holds
    then putStrLn "picker_contract: all checks passed"
    else putStrLn "picker_contract: FAILED"
