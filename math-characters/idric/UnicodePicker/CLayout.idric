module UnicodePicker.CLayout

import UnicodePicker

%default total

join_strings : String → List String → String
join_strings _ [] = ""
join_strings _ [value] = value
join_strings separator (value :: rest) =
  value ++ separator ++ join_strings separator rest

escape_c_character : Char → String
escape_c_character '"' = "\\\""
escape_c_character '\\' = "\\\\"
escape_c_character '\n' = "\\n"
escape_c_character '\r' = "\\r"
escape_c_character '\t' = "\\t"
escape_c_character character = pack [character]

c_string : String → String
c_string value = "\"" ++ concatMap escape_c_character (unpack value) ++ "\""

action_name : picker_action → String
action_name (insert_text _) = "PAD_INSERT"
action_name (insert_pair _) = "PAD_INSERT_PAIR"
action_name (view_slot _) = "PAD_VIEW_SLOT"
action_name (remember_slot _) = "PAD_REMEMBER_SLOT"
action_name (write_slot _) = "PAD_WRITE_SLOT"

action_text : picker_action → String
action_text (insert_text text) = c_string text
action_text (insert_pair text) = c_string text
action_text (view_slot _) = "NULL"
action_text (remember_slot _) = "NULL"
action_text (write_slot _) = "NULL"

action_argument : picker_action → String
action_argument (insert_text _) = "0u"
action_argument (insert_pair _) = "0u"
action_argument (view_slot slot) = show slot ++ "u"
action_argument (remember_slot slot) = show slot ++ "u"
action_argument (write_slot slot) = show slot ++ "u"

render_key : PickerKey → String
render_key (Key label action) =
  "KEY(" ++ c_string label ++ ", " ++ action_name action ++ ", " ++
  action_text action ++ ", " ++ action_argument action ++ ")"

key_array_name : Nat → Nat → String
key_array_name page_index row_index =
  "idric_page_" ++ show page_index ++ "_row_" ++ show row_index ++ "_keys"

row_array_name : Nat → String
row_array_name page_index = "idric_page_" ++ show page_index ++ "_rows"

render_key_lines : List PickerKey → String
render_key_lines [] = ""
render_key_lines (key :: rest) =
  "    " ++ render_key key ++ ",\n" ++ render_key_lines rest

render_row_arrays : Nat → Nat → List PickerRow → String
render_row_arrays _ _ [] = ""
render_row_arrays page_index row_index (Row keys :: rest) =
  "static const PadKey " ++ key_array_name page_index row_index ++ "[] = {\n" ++
  render_key_lines keys ++
  "};\n" ++
  render_row_arrays page_index (S row_index) rest

render_row_references : Nat → Nat → List PickerRow → List String
render_row_references _ _ [] = []
render_row_references page_index row_index (_ :: rest) =
  ("ROW(" ++ key_array_name page_index row_index ++ ")") ::
  render_row_references page_index (S row_index) rest

render_page : Nat → PickerPage → String
render_page page_index (Page _ rows) =
  render_row_arrays page_index 0 rows ++
  "static const PadRow " ++ row_array_name page_index ++ "[] = {\n    " ++
  join_strings ",\n    " (render_row_references page_index 0 rows) ++
  "\n};\n\n"

render_pages : Nat → List PickerPage → String
render_pages _ [] = ""
render_pages page_index (page :: rest) =
  render_page page_index page ++ render_pages (S page_index) rest

render_layout_references : Nat → List PickerPage → List String
render_layout_references _ [] = []
render_layout_references page_index (Page name _ :: rest) =
  ("{" ++ c_string name ++ ", " ++ row_array_name page_index ++
   ", COUNT_OF(" ++ row_array_name page_index ++ ")}") ::
  render_layout_references (S page_index) rest

public export
render_picker_layouts_as_c : List PickerPage → String
render_picker_layouts_as_c picker_pages =
  "/* Generated from idric/UnicodePicker.idric by Idriç. Do not edit. */\n\n" ++
  render_pages 0 picker_pages ++
  "static const PadLayout layouts[] = {\n    " ++
  join_strings ",\n    " (render_layout_references 0 picker_pages) ++
  "\n};\n"
