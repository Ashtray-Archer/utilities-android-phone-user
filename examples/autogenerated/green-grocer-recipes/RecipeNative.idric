module RecipeNative

import RecipeShopping
import RecipeStorage
import RecipeSession
import RecipeScreen
import RecipeDraft
import RecipeText
import RecipeEditorSession
import RecipeEditorScreen
import RecipeEditor
import RecipeFiles
import RecipeFilePlatform
import Data.IORef
import Data.List
import Data.Text

-- Only filesystem naming/ownership lives here. Recipe actions and quantities
-- remain in the checked model; C retains the returned session without decoding it.
data FileReference : Type where [external]

%foreign "dex:construct:Ljava/io/File;:<init>:(Ljava/lang/String;)V"
file_at : Text → PrimIO FileReference
%foreign "dex:virtual:Ljava/io/File;:exists:()Z"
file_exists : FileReference → PrimIO Int32

recipe_path : Text → Recipe → IO Text
recipe_path directory recipe = pure (directory ++ "/" ++
  show (foldl fingerprint 0 (unpack recipe.recipe_identity)) ++ ".recipe")
  where
    -- A bounded filename key, not an authentication hash or recipe identity.
    -- The full identity is stored in the file and checked before replacement.
    -- Collisions refuse; they never merge or overwrite different recipes.
    fingerprint : Integer → Char → Integer
    fingerprint previous character = mod (previous × 131 + cast (ord character))
      340282366920938463463374607431768211456

save_owned_recipe : Text → Recipe → ShoppingState → IO ShoppingState
save_owned_recipe directory recipe state = do
  result ← newIORef state
  try_recipe_file (do
    path ← recipe_path directory recipe
    case recipe_file path of
      Left message ⇒ writeIORef result ({ notice := message } state)
      Right file ⇒ do
        base ← primIO (file_at path)
        backup ← primIO (file_at (path ++ ".bak"))
        base_exists ← primIO (file_exists base)
        backup_exists ← primIO (file_exists backup)
        allowed ← if base_exists ≟ 0 && backup_exists ≟ 0 then pure True else do
          previous ← read_recipe_text path
          pure (case decode_recipe previous of
            Right saved ⇒ saved.recipe_identity ≟ recipe.recipe_identity
            Left _ ⇒ False)
        if allowed
          then do
            saved ← save_recipe_file file recipe state
            writeIORef result saved
          else writeIORef result ({ notice := "Existing recipe file has a different or unreadable identity" } state))
    (writeIORef result ({ notice := "Recipe save could not be confirmed; current recipes retained" } state))
  readIORef result

%export "dex:recipe_session_valid"
recipe_session_valid : Text → Bool
recipe_session_valid encoded = case decode_editor encoded of
  Left _ ⇒ False
  Right _ ⇒ True

%export "dex:recipe_session_can_go_back"
recipe_session_can_go_back : Text → Bool
recipe_session_can_go_back encoded = case decode_editor encoded of
  Left _ ⇒ False
  Right state ⇒ editor_can_go_back state

%export "dex:recipe_session_start"
recipe_session_start : Text
recipe_session_start = encode_editor begin_editor

%export "dex:recipe_session_view"
recipe_session_view : Text → Text
recipe_session_view encoded = case decode_editor encoded of
  Left message ⇒ encode_view (View "Recipe session refused" message [])
  Right state ⇒ encode_view (editor_view state)

%export "dex:recipe_session_restore"
recipe_session_restore : Text → Text → IO Text
recipe_session_restore encoded path = case (decode_editor encoded, recipe_file path) of
  (Right session, Right file) ⇒ do
    state ← load_recipe_file file session.shopping
    pure (encode_editor ({ shopping := state } session))
  _ ⇒ pure encoded

%export "dex:recipe_session_import"
recipe_session_import : Text → Text → Text → IO Text
recipe_session_import encoded path directory = case decode_editor encoded of
  Left _ ⇒ pure encoded
  Right session ⇒ do
    let state = session.shopping
    result ← newIORef state
    try_recipe_file (do
      source ← read_recipe_text path
      case decode_recipe source of
        Left problem ⇒ writeIORef result ({ notice := "Recipe file refused: " ++ problem } state)
        Right recipe ⇒ do
          saved ← save_owned_recipe directory recipe state
          writeIORef result saved)
      (writeIORef result ({ notice := "Recipe import failed; previous recipes retained" } state))
    saved ← readIORef result
    pure (encode_editor ({ shopping := saved } session))

%export "dex:recipe_session_action"
recipe_session_action : Text → Text → Text → IO Text
recipe_session_action encoded token directory = case decode_editor encoded of
  Left _ ⇒ pure encoded
  Right session ⇒
    if not (visible_editor_action token session) then pure (encode_editor (editor_action token session))
    else case decode_fields token of
      Right ["editor:save"] ⇒ case session.draft of
        Nothing ⇒ pure encoded
        Just draft ⇒ case validate_draft draft of
          Left _ ⇒ pure (encode_editor (editor_action token session))
          Right recipe ⇒ do
            saved ← save_owned_recipe directory recipe session.shopping
            pure (encode_editor (finish_draft_save (saved.notice ≟ "Recipe saved") saved session))
      Right ["save", identity] ⇒ case find
        (\recipe ⇒ recipe.recipe_identity ≟ identity) session.shopping.saved_recipes of
          Nothing ⇒ pure (encode_editor ({ shopping.notice := "Saved recipe is missing" } session))
          Just recipe ⇒ do
            saved ← save_owned_recipe directory recipe session.shopping
            pure (encode_editor ({ shopping := saved } session))
      _ ⇒ pure (encode_editor (editor_action token session))

%export "dex:recipe_session_effectful"
recipe_session_effectful : Text → Text → Bool
recipe_session_effectful encoded token = case decode_editor encoded of
  Left _ ⇒ False
  Right session ⇒ visible_editor_action token session && case decode_fields token of
    Right ["editor:save"] ⇒ True
    Right ["save", _] ⇒ True
    _ ⇒ False

%export "dex:recipe_session_merge_effect"
recipe_session_merge_effect : Text → Text → Text → Text
recipe_session_merge_effect before latest result = case
  (decode_editor before, decode_editor latest, decode_editor result) of
    (Right old, Right current, Right changed) ⇒ encode_editor (merge_file_effect old current changed)
    _ ⇒ latest

%export "dex:recipe_session_input_snapshot"
recipe_session_input_snapshot : Text → Text
recipe_session_input_snapshot encoded = case decode_editor encoded of
  Left _ ⇒ input_snapshot begin_editor
  Right session ⇒ input_snapshot session

%export "dex:recipe_session_input"
recipe_session_input : Text → Text → Text → Text → Int32 → Int32 → Text
recipe_session_input encoded expected operation text first last = case decode_editor encoded of
  Left _ ⇒ encode_fields ["no", encoded]
  Right session ⇒ if operation ≟ "done" && not (expected ≟ "") && expected ≟ input_target session
    then encode_fields ["yes", encode_editor (editor_back session)]
    else case input_command operation text (cast first) (cast last) of
      Left _ ⇒ encode_fields ["no", encoded]
      Right command ⇒ let (accepted, next) = apply_field_command expected command session
        in encode_fields [if accepted then "yes" else "no", encode_editor next]

%export "dex:recipe_session_replace"
recipe_session_replace : Text → Text → Text → Int32 → Int32 → Int32 → Text
recipe_session_replace encoded expected text first last cursor = case decode_editor encoded of
  Left _ ⇒ encode_fields ["no", encoded]
  Right session ⇒ let (accepted, next) = apply_field_command expected (replace_text (cast first) (cast last) text (cast cursor)) session
    in encode_fields [if accepted then "yes" else "no", encode_editor next]

main : IO ()
main = pure ()
